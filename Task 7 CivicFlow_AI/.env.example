# ==========================================================
# CivicFlow AI — environment template
# ----------------------------------------------------------
# Copy karein:  cp .env.example .env     (Windows: copy .env.example .env)
# Phir .env mein apni asli keys daalein.
# .env NEVER commit hoti — .gitignore mein already hai.
# ==========================================================

# --- LLM: Groq primary (free tier, fast) ------------------
# Key yahan se: https://console.groq.com/keys
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.2

# --- LLM fallback: Google Gemini (optional) ---------------
# Key yahan se: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Observability: LangSmith (optional but recommended) --
# Key yahan se: https://smith.langchain.com
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=civicflow-ai
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# --- External tools (optional) ----------------------------
# Weather se flooding risk boost hota hai: https://openweathermap.org/api
OPENWEATHER_API_KEY=

# --- Storage ----------------------------------------------
DATABASE_URL=sqlite:///./civicflow.db
CHROMA_DB_PATH=./chroma_store
LANGGRAPH_CHECKPOINT_PATH=./checkpoints/civicflow_checkpoints.sqlite

# --- Engine behaviour -------------------------------------
# true  = LLM na ho to app rule-based degraded mode mein chalti hai
#         (UI par saaf "Degraded mode" banner dikhta hai)
# false = LLM na ho to submit fail ho jata hai
ALLOW_DEGRADED_MODE=true

# Critic agent confidence is se kam ho to HITL par jata hai (0.0 - 1.0)
CRITIC_CONFIDENCE_THRESHOLD=0.7

# Reflection loop max retries (infinite loop guard)
MAX_AGENT_RETRIES=2
